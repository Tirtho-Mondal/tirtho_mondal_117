<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Academic portfolio of Tirtho Mondal — CSE Student, Software Developer, and AI & Accessibility Enthusiast. Open to research, internship, and scholarship opportunities." />
  <meta property="og:title" content="Tirtho Mondal | Academic Portfolio" />
  <meta property="og:description"
    content="CSE Student, Software Developer, and Research Enthusiast. View research interests, projects, publications, and CV." />
  <meta property="og:type" content="website" />
  <title>Tirtho Mondal | Academic Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>

<body>

  <!-- ===== FULL PAGE CANVAS BACKGROUND ===== -->
  <canvas id="bgCanvas" class="bg-canvas" aria-hidden="true"></canvas>

  <!-- ===== BACKGROUND BLOBS ===== -->
  <div class="bg-blobs" aria-hidden="true">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>



  <!-- ===== SCROLL PROGRESS BAR ===== -->
  <div id="scrollProgress" class="scroll-progress" aria-hidden="true"></div>

  <!-- ===== NAVBAR ===== -->
  <header class="navbar" id="navbar" role="banner">
    <div class="container navbar__inner">
      <a href="#home" class="navbar__logo" aria-label="Go to top">
        <span class="logo__monogram">TM</span>
        <span class="logo__name">Tirtho Mondal</span>
      </a>
      <nav class="navbar__nav" id="navMenu" role="navigation" aria-label="Main navigation">
        <ul class="nav__list">
          <li><a href="#home" class="nav__link active">Home</a></li>
          <li><a href="#about" class="nav__link">About</a></li>
          <li><a href="#education" class="nav__link">Education</a></li>
          <li><a href="#research" class="nav__link">Research</a></li>
          <li><a href="#skills" class="nav__link">Skills</a></li>
          <li><a href="#projects" class="nav__link">Projects</a></li>
          <li><a href="#publications" class="nav__link">Publications</a></li>
          <li><a href="#achievements" class="nav__link">Achievements</a></li>
          <li><a href="#cv" class="nav__link">CV</a></li>
          <!-- <li><a href="#contact" class="nav__link">Contact</a></li> -->
        </ul>
      </nav>
      <div class="navbar__actions">
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle theme">
          <span class="theme-toggle__icon" id="themeIcon">☀</span>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Toggle mobile menu" aria-expanded="false">
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===== MAIN CONTENT ===== -->
  <main id="home">

    <!-- ===== HERO SECTION ===== -->
    <section class="hero" aria-labelledby="heroHeading">
      <div class="container hero__inner">
        <div class="hero__content reveal">
          <div class="availability-badge">
            <span class="badge__dot"></span>
            Available for Research &amp; Internship Opportunities
          </div>
          <p class="hero__pretitle">Hello, I'm</p>
          <h1 class="hero__name" id="heroHeading">Tirtho Mondal</h1>
          <h2 class="hero__title">CSE Student | Software Developer | AI &amp; Accessibility Enthusiast</h2>
          <p class="hero__university">📍 Khulna University of Engineering &amp; Technology (KUET) &nbsp;·&nbsp;
            Department of Computer Science and Engineering</p>
          <div class="hero__typing-wrapper" aria-live="polite">
            <span class="typing-static">I am a&nbsp;</span>
            <span class="typing-text" id="typingText"></span>
            <span class="typing-cursor" aria-hidden="true">|</span>
          </div>
          <p class="hero__intro">
            A dedicated undergraduate student driven by academic curiosity, a passion for technology-driven research,
            and the aspiration to solve real-world problems through innovation and rigorous inquiry.
          </p>
          <p class="hero__mission">
            <em>"To contribute meaningfully to the advancement of computer science through disciplined research,
              collaborative learning, and ethical innovation."</em>
          </p>
          <div class="hero__cta">
            <a href="#cv" class="btn btn--primary">📄 View CV</a>
            <a href="#projects" class="btn btn--secondary">🔬 View Projects</a>
            <a href="mailto:tirthomondal.2001@gmail.com" class="btn btn--outline">✉ Contact Me</a>
          </div>
        </div>
        <div class="hero__visual">
          <div class="profile-card">
            <!-- Animated satellites for side visual interest -->
            <div class="profile-satellite satellite--1" aria-hidden="true"></div>
            <div class="profile-satellite satellite--2" aria-hidden="true"></div>
            <div class="profile-satellite satellite--3" aria-hidden="true"></div>
            <div class="profile-card__avatar">
              <div class="avatar-image-wrapper" aria-label="Profile photo">
                <img src="profile.jpg" alt="Tirtho Mondal - Professional Profile" class="profile-img" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ABOUT SECTION ===== -->
    <section class="section" id="about" aria-labelledby="aboutHeading">
      <div class="container">
        <div class="section__header reveal">
          <span class="section__tag">Who I Am</span>
          <h2 class="section__title" id="aboutHeading">About Me</h2>
          <div class="section__divider"></div>
        </div>
        <div class="about__grid">
          <div class="about__bio reveal">
            <p class="about__lead">I am a highly motivated undergraduate student in Computer Science, currently pursuing
              my degree at [University Name]. My academic journey has been shaped by a deep intellectual curiosity about
              the intersection of artificial intelligence, data systems, and human-centered computing.</p>
            <p>Throughout my studies, I have consistently sought opportunities beyond the classroom — engaging in
              self-directed research, collaborative projects, and academic communities that challenge and elevate my
              thinking. I believe that meaningful research begins with asking the right questions and is sustained by
              discipline, rigor, and empathy.</p>
            <p>My long-term career objective is to contribute to research in [Your Research Area] — developing solutions
              that are not only technically sound but ethically responsible and socially impactful.</p>
            <div class="about__values">
              <div class="value-item">
                <span class="value-icon">🎯</span>
                <div>
                  <strong>Academic Integrity</strong>
                  <p>Commitment to honest, rigorous, and reproducible research practices.</p>
                </div>
              </div>
              <div class="value-item">
                <span class="value-icon">🔭</span>
                <div>
                  <strong>Lifelong Learning</strong>
                  <p>Continuous exploration of new ideas, technologies, and methodologies.</p>
                </div>
              </div>
              <div class="value-item">
                <span class="value-icon">🤝</span>
                <div>
                  <strong>Collaborative Spirit</strong>
                  <p>Strong belief in interdisciplinary teamwork and open knowledge sharing.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="about__details reveal reveal--right">
            <div class="info-card">
              <h3 class="info-card__title">Quick Profile</h3>
              <ul class="info-list">
                <li><span class="info-label">Name</span><span class="info-value">Tirtho Mondal</span></li>
                <li><span class="info-label">Degree</span><span class="info-value">B.Sc. in Computer Science and
                    Engineering</span></li>
                <li><span class="info-label">University</span><span class="info-value">Khulna University of Engineering
                    &amp; Technology (KUET)</span></li>
                <li><span class="info-label">Current Status</span><span class="info-value">4th Year – 2nd
                    Semester</span></li>
                <li><span class="info-label">CGPA</span><span class="info-value">3.72 / 4.00</span></li>
                <li><span class="info-label">Status</span><span class="info-value status--open">Open to
                    Opportunities</span></li>
                <li><span class="info-label">Languages</span><span class="info-value">Bengali, English</span></li>
                <li><span class="info-label">Location</span><span class="info-value">Kapilmuni, Khulna,
                    Bangladesh</span></li>
              </ul>
            </div>
            <div class="local-time-widget" id="localTimeWidget">
              <span class="time-icon">🕐</span>
              <div>
                <p class="time-label">My Local Time</p>
                <p class="time-display" id="localTime">--:--:--</p>
                <p class="time-zone" id="localDate">---</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== EDUCATION SECTION ===== -->
    <section class="section section--alt" id="education" aria-labelledby="eduHeading">
      <div class="container">
        <div class="section__header reveal">
          <span class="section__tag">Academic Background</span>
          <h2 class="section__title" id="eduHeading">Education</h2>
          <div class="section__divider"></div>

              <div class="timeline__header">
                <div>
                  <h3 class="timeline__degree">Bachelor of Science in Computer Science and Engineering</h3>
                  <p class="timeline__institution">🏛 Khulna University of Engineering &amp; Technology (KUET)</p>
                  <p class="timeline__dept">Department of Computer Science and Engineering</p>
                </div>
                <span class="timeline__date">2021 – 2025</span>
              </div>
              <div class="timeline__body">
                <div class="edu-meta">
                  <span class="edu-tag">CGPA: 3.72/4.00</span>
                  <span class="edu-tag edu-tag--gold">Dean's List</span>
                  <span class="edu-tag">Current Status: 4th Year - 2nd Semester</span>
                </div>
                <div class="coursework">
                  <p class="coursework__label">Relevant Coursework:</p>
                  <div class="coursework__tags">
                    <span>Data Structures & Algorithms</span>
                    <span>Machine Learning</span>
                    <span>Database Systems</span>
                    <span>Operating Systems</span>
                    <span>Computer Networks</span>
                    <span>Software Engineering</span>
                    <span>Artificial Intelligence</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="timeline__item reveal">
            <div class="timeline__marker"></div>
            <div class="timeline__card">
              <div class="timeline__header">
                <div>
                  <h3 class="timeline__degree">Higher Secondary Certificate (HSC)</h3>
                  <p class="timeline__institution">🏫 Kapilmuni College</p>
                  <p class="timeline__dept">Jashore Board | Science</p>
                </div>
                <span class="timeline__date">2018 – 2020</span>
              </div>
              <div class="timeline__body">
                <div class="edu-meta">
                  <span class="edu-tag">GPA: 5.00/5.00</span>
                  <span class="edu-tag edu-tag--gold">Academic Excellence</span>
                </div>
              </div>
            </div>
          </div>
        </div>

    <!-- ===== RESEARCH INTERESTS SECTION ===== -->
    <section class="section" id="research" aria-labelledby="researchHeading">
      <div class="container">
        <div class="section__header reveal">
          <span class="section__tag">Academic Focus</span>
          <h2 class="section__title" id="researchHeading">Research Interests</h2>
          <div class="section__divider"></div>
        </div>
        <div class="research-grid">
          <div class="research-card reveal">
            <div class="research-card__icon">🤖</div>
            <h3>Artificial Intelligence</h3>
            <p>Exploring intelligent agent design, knowledge representation, and AI ethics — with a focus on building
              systems that reason effectively and responsibly.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">📊</div>
            <h3>Machine Learning</h3>
            <p>Investigating deep learning architectures, transfer learning, and model interpretability to solve complex
              classification and prediction problems.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">🗄</div>
            <h3>Data Science</h3>
            <p>Applying statistical analysis, data mining, and visualization techniques to extract meaningful insights
              from large-scale datasets.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">⚙</div>
            <h3>Software Engineering</h3>
            <p>Studying software architecture, design patterns, and agile methodologies to build scalable, maintainable,
              and testable software systems.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">🌐</div>
            <h3>Web Technologies</h3>
            <p>Researching progressive web applications, accessibility, and performance optimization in modern web
              ecosystems.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">🛡</div>
            <h3>Cybersecurity</h3>
            <p>Examining threat modeling, cryptographic protocols, and secure system design to address emerging
              vulnerabilities in digital infrastructure.</p>
          </div>
          <div class="research-card reveal">
            <div class="research-card__icon">🖥</div>
            <h3>Human-Computer Interaction</h3>
            <p>Exploring usability engineering, cognitive load, and inclusive design to create interfaces that are
              intuitive and accessible to all users.</p>
          </div>
        </div>
      </div>
    </section>


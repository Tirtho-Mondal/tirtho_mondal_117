    <!-- ===== PROJECTS SECTION ===== -->
    <section class="section" id="projects" aria-labelledby="projectsHeading">
      <div class="container">
        <div class="section__header reveal">
          <span class="section__tag">Portfolio</span>
          <h2 class="section__title" id="projectsHeading">Academic Projects</h2>
          <div class="section__divider"></div>
        </div>
        <!-- Filter Buttons -->
        <div class="filter-bar reveal" role="group" aria-label="Project filters">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="ml">Machine Learning</button>
          <button class="filter-btn" data-filter="web">Web Dev</button>
          <button class="filter-btn" data-filter="data">Data Science</button>
          <button class="filter-btn" data-filter="research">Research</button>
        </div>
        <!-- Projects Grid -->
        <div class="projects-grid" id="projectsGrid">
          <div class="project-card reveal" data-category="ml" data-project="0">
            <div class="project-card__header">
              <span class="project-tag">Machine Learning</span>
              <div class="project-card__links">
                <a href="#" aria-label="GitHub" class="project-link">⌥ GitHub</a>
                <a href="#" aria-label="Demo" class="project-link">▶ Demo</a>
              </div>
            </div>
            <h3 class="project-card__title">Sentiment Analysis of Academic Feedback</h3>
            <p class="project-card__desc">Developed an NLP-based sentiment classifier to analyze student feedback data,
              achieving 91% accuracy using fine-tuned BERT embeddings.</p>
            <div class="project-tech">
              <span>Python</span><span>BERT</span><span>HuggingFace</span><span>Flask</span>
            </div>
            <button class="btn btn--sm project-detail-btn" data-project="0">View Details →</button>
          </div>

          <div class="project-card reveal" data-category="web" data-project="1">
            <div class="project-card__header">
              <span class="project-tag">Web Development</span>
              <div class="project-card__links">
                <a href="#" aria-label="GitHub" class="project-link">⌥ GitHub</a>
                <a href="#" aria-label="Demo" class="project-link">▶ Live</a>
              </div>
            </div>
            <h3 class="project-card__title">University Research Portal</h3>
            <p class="project-card__desc">A collaborative web platform enabling researchers to share findings, annotate
              papers, and coordinate literature reviews within departments.</p>
            <div class="project-tech">
              <span>React</span><span>Node.js</span><span>MongoDB</span><span>JWT Auth</span>
            </div>
            <button class="btn btn--sm project-detail-btn" data-project="1">View Details →</button>
          </div>

          <div class="project-card reveal" data-category="data" data-project="2">
            <div class="project-card__header">
              <span class="project-tag">Data Science</span>
              <div class="project-card__links">
                <a href="#" aria-label="GitHub" class="project-link">⌥ GitHub</a>
                <a href="#" aria-label="Report" class="project-link">📄 Report</a>
              </div>
            </div>
            <h3 class="project-card__title">Predictive Analytics for Student Performance</h3>
            <p class="project-card__desc">Built a multi-feature regression model to predict academic performance from
